<Window x:Class="DualAudioMirror.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Áudio em Dois Dispositivos" Height="760" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                   Text="Tocar o mesmo som em 2 dispositivos ao mesmo tempo"/>

        <TextBlock Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="Escolha o dispositivo principal (onde o Windows toca) e marque o(s) outro(s) que devem tocar o MESMO som no mesmo instante."/>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Principal: "/>
            <ComboBox Grid.Column="1" x:Name="DeviceCombo" Margin="6,0"
                      DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectionChanged="DeviceCombo_SelectionChanged"/>
            <Button Grid.Column="2" x:Name="BtnRefresh" Content="Atualizar" Padding="10,3"
                    Click="BtnRefresh_Click"/>
        </Grid>

        <CheckBox Grid.Row="3" x:Name="ChkSetDefault" Margin="0,8,0,0" IsChecked="True"
                  Content="Definir principal como padrão do Windows"/>

        <CheckBox Grid.Row="4" x:Name="ChkSync" Margin="0,6,0,0" IsChecked="True"
                  Content="Modo sincronizado — tocar nos DOIS ao mesmo tempo (requer cabo de áudio virtual)"
                  Checked="ChkSync_Changed" Unchecked="ChkSync_Changed"/>

        <TextBlock Grid.Row="5" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="No modo sincronizado o cabo virtual (VB-Cable) vira a fonte e todos os aparelhos marcados abaixo tocam junto, com delay ajustável."/>

        <Grid Grid.Row="6" Margin="0,12,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="Também tocar o som em: (marque ao lado do nome)"/>
            <TextBlock Grid.Column="1" Width="48" Margin="2,0,2,0" FontWeight="SemiBold"
                       TextAlignment="Center" Text="Delay (ms)"/>
        </Grid>

        <ListBox Grid.Row="7" x:Name="TargetList" HorizontalContentAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="2,1"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="{Binding Name}"
                                  IsChecked="{Binding Selected, Mode=TwoWay}"
                                  VerticalAlignment="Center" Padding="4,3"
                                  ToolTip="Marcar para este aparelho tocar junto"/>
                        <TextBox Grid.Column="1" Width="48" Height="22"
                                 TextAlignment="Center" VerticalAlignment="Center"
                                 ToolTip="Compensa o atraso físico do dispositivo"
                                 Text="{Binding DelayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="DelayBox_PreviewTextInput"
                                 LostFocus="DelayBox_LostFocus"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnStart" Content="Iniciar" Padding="18,7" FontWeight="Bold"
                    Click="BtnStart_Click"/>
            <Button x:Name="BtnStop" Content="Parar" Padding="18,7" Margin="10,0,0,0"
                    IsEnabled="False" Click="BtnStop_Click"/>
            <Button x:Name="BtnTest" Content="Testar som" Padding="14,7" Margin="10,0,0,0"
                    Click="BtnTest_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusLine" Grid.Row="9" Margin="0,10,0,0"
                   TextWrapping="Wrap" Foreground="Gray"/>

        <TextBlock x:Name="StatsLine" Grid.Row="10" Margin="0,6,0,0"
                   TextWrapping="Wrap" FontFamily="Consolas" Foreground="DodgerBlue"/>

        <Grid Grid.Row="11" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Log: "/>
            <TextBlock Grid.Column="1" x:Name="LogPathText" Foreground="DodgerBlue"
                       TextDecorations="Underline" Cursor="Hand" TextTrimming="CharacterEllipsis"
                       MouseLeftButtonUp="LogPathText_MouseLeftButtonUp"
                       ToolTip="Clique para abrir o arquivo de log"/>
        </Grid>

        <TextBox Grid.Row="12" x:Name="LogBox" Margin="0,4,0,0" Height="92"
                 IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
