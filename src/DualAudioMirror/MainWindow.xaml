<Window x:Class="DualAudioMirror.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DualAudioMirror — Áudio em Dois Dispositivos"
        Icon="pack://application:,,,/icon.ico"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        Height="880" Width="600" MinHeight="700" MinWidth="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="22" Height="22"
                   Source="pack://application:,,,/icon.ico"
                   VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Style="{DynamicResource Style.H1}"
                       Margin="8,0,6,0" VerticalAlignment="Center"
                       Text="DualAudioMirror"/>
            <TextBlock Grid.Column="2" x:Name="VersionText"
                       Style="{DynamicResource Style.Caption}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="4" x:Name="BtnThemeToggle"
                    Style="{DynamicResource Style.BtnSecondary}"
                    Content="Tema" Click="BtnThemeToggle_Click"/>
            <Button Grid.Column="5" x:Name="BtnCheckUpdate"
                    Style="{DynamicResource Style.BtnSecondary}"
                    Content="Verificar atualização"
                    Margin="8,0,0,0" Click="BtnCheckUpdate_Click"/>
        </Grid>

        <Border Grid.Row="1" Style="{DynamicResource Style.Card}">
            <StackPanel>
                <TextBlock Style="{DynamicResource Style.H2}" Margin="0,0,0,8"
                           Text="Dispositivos"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Principal: "/>
                    <ComboBox Grid.Column="1" x:Name="DeviceCombo" Margin="6,0"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="DeviceCombo_SelectionChanged"/>
                    <Button Grid.Column="2" x:Name="BtnRefresh"
                            Style="{DynamicResource Style.BtnSecondary}"
                            Content="Atualizar" Click="BtnRefresh_Click"/>
                </Grid>
                <TextBlock Style="{DynamicResource Style.Body}" Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Text="Escolha o dispositivo principal (onde o Windows toca) e marque o(s) outro(s) que devem tocar o MESMO som no mesmo instante."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource Style.Card}">
            <StackPanel>
                <TextBlock Style="{DynamicResource Style.H2}" Margin="0,0,0,8"
                           Text="Opções"/>
                <CheckBox x:Name="ChkSetDefault" IsChecked="True"
                          Content="Definir principal como padrão do Windows"/>
                <CheckBox x:Name="ChkSync" Margin="0,6,0,0" IsChecked="True"
                          Content="Modo sincronizado — tocar nos DOIS ao mesmo tempo (requer cabo de áudio virtual)"
                          Checked="ChkSync_Changed" Unchecked="ChkSync_Changed"/>
                <TextBlock Style="{DynamicResource Style.Body}" Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="No modo sincronizado o cabo virtual (VB-Cable) vira a fonte e todos os aparelhos marcados abaixo tocam junto, com delay ajustável."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{DynamicResource Style.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{DynamicResource Style.H2}"
                               TextWrapping="Wrap"
                               Text="Também tocar o som em:"/>
                    <TextBlock Grid.Column="1" Margin="8,0,2,0"
                               Style="{DynamicResource Style.H2}"
                               TextAlignment="Center" Text="Delay (ms)"/>
                </Grid>
                <ListBox Grid.Row="1" x:Name="TargetList" MinHeight="140"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding Name}"
                                          IsChecked="{Binding Selected, Mode=TwoWay}"
                                          VerticalAlignment="Center" Padding="4,3"
                                          ToolTip="Marcar para este aparelho tocar junto"/>
                                <TextBox Grid.Column="1" Width="48" Height="22"
                                         TextAlignment="Center" VerticalAlignment="Center"
                                         ToolTip="Compensa o atraso físico do dispositivo"
                                         Text="{Binding DelayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewTextInput="DelayBox_PreviewTextInput"
                                         LostFocus="DelayBox_LostFocus"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{DynamicResource Style.Card}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnStart" Content="Iniciar"
                        Style="{DynamicResource Style.BtnPrimary}"
                        Click="BtnStart_Click"/>
                <Button x:Name="BtnStop" Content="Parar" Margin="10,0,0,0"
                        Style="{DynamicResource Style.BtnSecondary}"
                        IsEnabled="False" Click="BtnStop_Click"/>
                <Button x:Name="BtnTest" Content="Testar som" Margin="10,0,0,0"
                        Style="{DynamicResource Style.BtnSecondary}"
                        Click="BtnTest_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Style="{DynamicResource Style.StatusPill}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" x:Name="StatusDot" Width="8" Height="8"
                         Fill="{DynamicResource Brush.TextSecondary}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="StatusLine"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextPrimary}"/>
            </Grid>
        </Border>

        <Border Grid.Row="6" x:Name="StatsCard" Style="{DynamicResource Style.Card}">
            <TextBlock x:Name="StatsLine" FontFamily="Consolas" FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Accent}"/>
        </Border>

        <Border Grid.Row="7" Style="{DynamicResource Style.Card}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Log: "/>
                    <TextBlock Grid.Column="1" x:Name="LogPathText"
                               Foreground="{DynamicResource Brush.Accent}"
                               TextDecorations="Underline" Cursor="Hand"
                               TextTrimming="CharacterEllipsis"
                               MouseLeftButtonUp="LogPathText_MouseLeftButtonUp"
                               ToolTip="Clique para abrir o arquivo de log"/>
                </Grid>
                <TextBox x:Name="LogBox" Height="72"
                         IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
